# Copy this file to .env.production on the deployment host.
# Replace every placeholder with long, unique secrets. Never commit the real file.

MYSQL_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_ROOT_PASSWORD
MYSQL_USER=mall4j_app
MYSQL_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_REDIS_PASSWORD
SHOP_TOKEN_AES_KEY=REPLACE_WITH_32_CHAR_RANDOM_AES_KEY

# Public HTTPS endpoints; use hostnames covered by valid TLS certificates.
MALL4J_API_BASE_URL=https://api.example.com
MALL4J_ADMIN_API_BASE_URL=https://admin-api.example.com
MALL4J_RESOURCES_BASE_URL=https://admin-api.example.com/mall4j/img/
MALL4J_ADMIN_WEB_ORIGIN=https://admin.example.com

# Path to a separate checkout of gz-yami/mall4j on the deployment host.
MALL4J_SOURCE_DIR=../mall4j-upstream

# Configure this only after deploying the XXL-JOB admin service.
XXL_JOB_ADDRESS=http://xxl-job:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=REPLACE_WITH_LONG_RANDOM_JOB_TOKEN
